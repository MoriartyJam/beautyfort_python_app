APP_URL=https://your-app.seenode.app
APP_ENVIRONMENT=production
APP_SECRET=replace-with-a-long-random-value
TOKEN_ENCRYPTION_KEY=replace-with-a-fernet-key
DATABASE_URL=postgresql+psycopg://user:password@host:5432/database

SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-10
SHOPIFY_SCOPES=write_products,write_inventory,read_locations
SHOPIFY_SHOP=
# Optional for a one-store custom app; OAuth token stored in DB takes precedence.
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_LOCATION_ID=

BEAUTYFORT_API_URL=https://www.beautyfort.com/api/soap
BEAUTYFORT_USERNAME=
BEAUTYFORT_SECRET=
BEAUTYFORT_TEST_MODE=false

SYNC_INTERVAL_MINUTES=60
WORKER_POLL_SECONDS=5
AUTOMATIC_APPLY=false
ADMIN_PASSWORD=
PORT=80
